# --- Secrets -------------------------------------------------------------
# Every .env variant, then one exception. A wildcard rather than a list:
# a file name nobody thought of (.env.prod, .env.staging) must be ignored,
# not committed to the repo.
.env
.env.*
!.env.example

# MCP servers are configured with the `local` or `user` scope. The project
# scope writes .mcp.json, which would push server URLs and tokens.
.mcp.json

# --- JavaScript / TypeScript --------------------------------------------
node_modules/
.pnpm-store/
.turbo/
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts
.vercel/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- Python ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Tests and coverage ---------------------------------------------------
coverage/
.coverage
.coverage.*
htmlcov/
test-results/
playwright-report/
blob-report/

# --- Data -------------------------------------------------------------------
# Real reports, photos and tenant data never enter this repo, private or not.
# Synthetic fixtures belong under a tracked fixtures/ folder instead.
data/
*.sqlite
*.db

# --- Agent and editor scratch ----------------------------------------------
.superpowers/
.scratch/
.claude/settings.local.json
.idea/
*.swp

# --- OS ------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

{
  "name": "streetproof",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @streetproof/db db:generate",
    "db:migrate": "pnpm --filter @streetproof/db db:migrate",
    "db:seed": "pnpm --filter @streetproof/db db:seed",
    "db:seed:demo": "pnpm --filter @streetproof/db db:seed:demo",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  }
}

# For compose.production.yaml. The same variables as .env.example, with the values
# a Docker host needs. Copy it outside the repo, or to a name git ignores, and fill
# it in. Never commit real values.

# --- Infrastructure -------------------------------------------------------------
# User, database and host stay as written. Generate the password with
# openssl rand -hex 32, because base64 can break the address.
DATABASE_URL=postgresql://streetproof:<password>@postgres:5432/streetproof

# The address the app reaches MinIO at, inside Docker.
S3_ENDPOINT_URL=http://minio:9000
# Generate each with: openssl rand -hex 32
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=streetproof
S3_REGION=us-east-1

# The address browsers load photos from: MinIO's port or its own domain.
S3_PUBLIC_ENDPOINT_URL=

# Not used yet: jobs run from the Postgres outbox.
REDIS_URL=

# --- App ------------------------------------------------------------------------
# The address people open. Sign-in cookies are secure only when this is https.
APP_URL=
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Secret for GET /api/monitoring, which stays hidden while this is empty.
MONITORING_TOKEN=

# --- Email (optional) -------------------------------------------------------
# Status updates, link recovery and password resets.
# Format: smtp://user:password@host:587
SMTP_URL=
MAIL_FROM=

# --- Third-party APIs (server-side only) ------------------------------------
# Meta Model API, see docs/meta-model-api.md. Each draft costs model credits.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# --- Maps -------------------------------------------------------------------
# Address search as you type, through the web server. Photon over OpenStreetMap;
# point it at your own Photon to keep searches in house.
GEOCODER_URL=https://photon.komoot.io

# --- Telegram bot (optional) -------------------------------------------------
# Token from @BotFather and the bot username without @. Without them the app works
# and sends nothing to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Docker deployment only (compose.production.yaml) ----------------------------
# Host ports, and days of nightly backups to keep. See docs/deployment.md.
WEB_PORT=3000
MINIO_PORT=9000
BACKUP_KEEP_DAYS=14

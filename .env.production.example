# For compose.production.yaml. Copy it outside the repo, or to a name git ignores,
# and fill it in. Never commit real values.

# Generate each secret with: openssl rand -base64 32
POSTGRES_PASSWORD=
AUTH_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=streetproof
S3_REGION=us-east-1

# The address people open. Sign-in cookies are secure only when this is https.
APP_URL=

# The address browsers load photos from: MinIO's port or its own domain.
S3_PUBLIC_ENDPOINT_URL=

# Host ports. Leave them out behind a proxy that routes by domain.
WEB_PORT=3000
MINIO_PORT=9000

# Meta Model API, see docs/meta-model-api.md. Each draft costs model credits.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

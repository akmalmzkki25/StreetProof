{
  "name": "@streetproof/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./demo": "./src/demo.ts",
    "./mail": "./src/mail.ts",
    "./telegram-send": "./src/telegram-send.ts",
    "./storage": "./src/storage.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:setup": "tsx scripts/setup.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:e2e:reset": "tsx scripts/reset-e2e.ts",
    "db:seed:demo": "tsx scripts/seed.ts && tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@streetproof/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "nodemailer": "^7.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.14",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  }
}

# Copy to .env and fill in locally. Never commit real values.
# Every unit that reads a new variable adds it here.

# --- Local infrastructure (Docker) ------------------------------------------
# PostgreSQL. Format: postgresql://<user>:<password>@localhost:5432/streetproof
DATABASE_URL=

# S3-compatible object storage (MinIO locally). Holds report and completion
# photos in a private bucket; the app serves them through short-lived URLs.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=streetproof
S3_REGION=us-east-1

# Only when browsers reach storage at a different address than the app does.
S3_PUBLIC_ENDPOINT_URL=

# Redis. Not used yet: jobs run from the Postgres outbox. Set it only when a
# unit starts reading it. Format: redis://:<password>@localhost:6379/0
REDIS_URL=

# --- App ------------------------------------------------------------------------
APP_URL=http://localhost:3000
# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Secret for GET /api/monitoring. The route stays hidden while this is empty.
MONITORING_TOKEN=

# --- Email (optional) -------------------------------------------------------
# Status emails to reporters, link recovery and password resets. Without these,
# the app works and sends no email. Format: smtp://user:password@host:587
SMTP_URL=
MAIL_FROM=

# --- Third-party APIs (server-side only) ------------------------------------
# Meta Model API: Muse Spark drafts the structured ticket from a report.
# See docs/meta-model-api.md. Keys are created in the Model API dashboard.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# --- Telegram bot (optional) -------------------------------------------------
# Token from @BotFather and the bot username without @. Without them the app works
# and sends nothing to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Docker deployment only (compose.production.yaml) ----------------------------
# Host ports, and days of nightly backups to keep. See docs/deployment.md.
WEB_PORT=3000
MINIO_PORT=9000
BACKUP_KEEP_DAYS=14

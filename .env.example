# Copy to .env and fill in locally. Never commit real values.
# Every unit that reads a new variable adds it here with an empty value.

# --- Supabase ---------------------------------------------------------------
# Public: safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: bypasses RLS. Worker and server code only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Direct Postgres connection for migrations and the worker.
DATABASE_URL=

# --- AI adapter (server-side only) ------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- App ------------------------------------------------------------------------
APP_URL=http://localhost:3000
